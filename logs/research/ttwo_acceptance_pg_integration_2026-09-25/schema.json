      "table_name": "paper_signals",
      "kind": "c",
      "definition": "CHECK (((action IS NOT NULL) AND (((action = ANY (ARRAY['SKIP_CASH'::text, 'SKIP_CAP'::text])) AND (purchase_committed_at IS NULL) AND (not_before_date IS NULL) AND (committed_amount IS NULL) AND (source_accession IS NULL) AND (source_acceptance_at IS NULL) AND (execution_session_date IS NULL)) OR ((action = ANY (ARRAY['PENDING_BUY'::text, 'BUY'::text])) AND (purchase_committed_at IS NOT NULL) AND (not_before_date IS NOT NULL) AND (committed_amount IS NOT NULL) AND (committed_amount > (0)::numeric) AND (committed_amount < 'Infinity'::numeric) AND (source_accession IS NOT NULL) AND (source_accession ~ '[^[:space:]]'::text) AND (source_acceptance_at IS NOT NULL) AND (source_acceptance_at <= purchase_committed_at) AND (not_before_date = (((purchase_committed_at AT TIME ZONE 'America/New_York'::text))::date + 1)) AND ((execution_session_date IS NULL) OR (execution_session_date >= not_before_date)) AND ((action = 'PENDING_BUY'::text) OR (execution_session_date IS NOT NULL))))))"
    },
